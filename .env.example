# The site's own origin, with no trailing slash. Drives the canonical URL,
# the Open Graph and Twitter image URLs, the sitemap and robots.txt. Set this
# to the live domain in production -- a canonical pointing at the wrong host
# tells search engines the real pages live somewhere else.
NEXT_PUBLIC_SITE_URL=https://wingback-giftverse.sampley.in

# Google Analytics 4 measurement ID. Read at BUILD time, not run time -- Next
# inlines NEXT_PUBLIC_* and bakes it into every prerendered page -- so the Docker
# build receives it as an argument (see docker-compose.yml). Left empty, no
# analytics tag is rendered at all, which is what keeps local development out of
# the property's data.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-3SF8H50FQF

# Seconds before the login OTP can be resent. The provider throttles at 60s,
# so a lower value only surfaces its "wait for one minute" error.
OTP_RESEND_SECONDS=60

# Where cart quote requests are POSTed. Left empty, the form falls back to
# opening a prefilled email to the sales address.
QUOTE_REQUEST_ENDPOINT=

# HYPERINVENTORY API SETUP
HYPERINVENTORY_API_URL=https://api.hyperinvento.com/v2
HYPERINVENTORY_SELLER_ID=
HYPERINVENTORY_SALESCHANNEL=
HYPERINVENTORY_CLIENT_ID=
HYPERINVENTORY_CLIENT_SECRET=
HYPERINVENTORY_SEARCH_TOKEN=
HYPERINVENTORY_ORIGIN=
HYPERINVENTORY_REFERER=

# Reserved for the future AI product search integration.
RANKNOVA_API_URL=

# COMPANY DETAILS
# Public business information printed on the site, not secrets. The code
# carries the same values as defaults, so the Docker build -- which runs
# without an environment -- still prerenders the static pages correctly.
COMPANY_NAME=Sampley
COMPANY_LEGAL_NAME=SampleyCart LLP
COMPANY_TOLL_FREE_NUMBER=8178539743
COMPANY_SUPPORT_EMAIL=go@sampley.in
COMPANY_BUSINESS_HOURS=Mon - Fri (9AM - 8PM)
COMPANY_GSTIN=21AEKFS3300K1ZA
COMPANY_ADDRESS=SampleyCart LLP, 795/11/2 1st floor C/O SURATH MACHUA, 5TH LANE, NUSANI, MATITOTA, Puri, Odisha, 752001
COMPANY_STREET_ADDRESS=795/11/2 1st floor C/O SURATH MACHUA, 5TH LANE, NUSANI, MATITOTA
COMPANY_CITY=Puri
COMPANY_STATE=Odisha
COMPANY_POSTAL_CODE=752001
COMPANY_COUNTRY=IN

# Floating WhatsApp button. Leave this line out and it uses
# COMPANY_TOLL_FREE_NUMBER. Set it to a different number to override, or
# include it with no value to remove the button from the site.
# COMPANY_WHATSAPP_NUMBER=

# The provider form the enquiry modal posts to (POST /consumer/form-items/).
DEMO_FORM_ID=a3625772-36a9-4255-bd44-698d5cbc6e3c

# Google reCAPTCHA. The provider rejects a submission without a valid token,
# so the modal falls back to opening an email until this is set.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
